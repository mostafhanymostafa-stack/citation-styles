<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0">
  <info>
    <title>College Style</title>
    <id>http://www.zotero.org/styles/college-style</id>
    <link href="http://www.zotero.org/styles/college-style" rel="self"/>
    <author>
      <name>Custom Style Generator</name>
    </author>
    <category citation-format="author-date"/>
    <updated>2026-01-05</updated>
  </info>
  <macro name="author">
    <names variable="author">
      <name delimiter="; " initialize-with="." name-as-sort-order="first"/>
    </names>
  </macro>
  <macro name="issued">
    <date variable="issued">
      <date-part name="year" prefix="(" suffix=")"/>
    </date>
  </macro>
  <macro name="title">
    <text variable="title" text-case="capitalize-first" suffix="."/>
  </macro>
  <macro name="container-title">
    <text variable="container-title" font-style="italic" suffix=","/>
  </macro>
  <macro name="volume-pages">
    <group delimiter=": ">
      <text variable="volume"/>
      <text variable="page"/>
    </group>
  </macro>
  <citation>
    <layout prefix="" suffix="" delimiter=" ">
      <text macro="author"/>
      <text macro="issued"/>
      <text macro="title"/>
      <text macro="container-title"/>
      <text macro="volume-pages"/>
    </layout>
  </citation>
  <bibliography>
    <layout suffix="." delimiter=" ">
      <text macro="author"/>
      <text macro="issued"/>
      <text macro="title"/>
      <text macro="container-title"/>
      <text macro="volume-pages"/>
    </layout>
  </bibliography>
</style>
